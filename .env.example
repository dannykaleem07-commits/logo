# Copy this file to .env (same folder) and fill it in. .env is never uploaded to GitHub.

# --- Claude (create a key at platform.claude.com -> API keys)
ANTHROPIC_API_KEY=

# --- IONOS mailbox the team works from
MAILBOX=claims@courtesycars.net
MAIL_PASSWORD=
IMAP_HOST=imap.ionos.co.uk
IMAP_PORT=993
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=465
SENDER_NAME=Danny Kaleem - Claims Manager

# --- The Director: approves every external email and receives reports
DIRECTOR_NAME=Shahzaib
DIRECTOR_EMAIL=

# --- Carflex engineers' email domain(s), comma separated, e.g. carflex.co.uk
CARFLEX_DOMAINS=

# --- Timing
SCAN_MINUTES=15
# Chase the other side once they have had this long with no reply
FOLLOWUP_HOURS=48
# How far back the very first scan reads the inbox and sent items
BACKFILL_DAYS=60
# Hemant's daily audit time (24h) and research day (0=Mon ... 6=Sun)
HEMANT_TIME=17:30
HEMANT_RESEARCH_WEEKDAY=0
HEMANT_MAX_CLAIMS=40

# --- Folder names in IONOS (created automatically)
CLIENTS_PARENT=Clients
AWAITING_FOLDER=Awaiting Shahzaib
APPROVED_FOLDER=Approved - Send
REJECTED_FOLDER=Rejected
UNALLOCATED_FOLDER=Unallocated - Needs Review
SPAM_FOLDER=Marketing - Spam
# Leave blank to auto-detect IONOS's Sent folder
SENT_FOLDER=

# --- Boss Hub
HUB_PORT=8765
# Phones: true lets your iPhone open the hub over the office Wi-Fi (or start with  hub --phone).
# A phone must be paired first: scan the QR code in Settings -> Phone, or enter the PIN.
HUB_ALLOW_LAN=false
# 4-8 digits. Blank = a PIN is generated once and shown in Settings -> Phone.
HUB_PIN=
# true adds a second, secure address (https) so the microphone works on the phone. One-time trust step on the phone.
HUB_HTTPS=false

# --- Voice (Microsoft neural voices via edge-tts: free, no key). Pick a voice in the hub's Settings,
#     or set one here, e.g. en-GB-SoniaNeural (warm), en-GB-LibbyNeural (bright), en-GB-RyanNeural (male, calm).
#     Each voice has its own tuned pace and pitch; the three lines below override that for every voice.
TTS_VOICE=en-GB-SoniaNeural
# e.g. +2% (a touch brisk), -2Hz (a touch lower, calmer), +10% (edge voices are quiet; never above +20%)
TTS_RATE=
TTS_PITCH=
TTS_VOLUME=
# Spoken sentences are kept in data/tts-cache so repeats (the greeting, "say that again") play instantly. Size cap in MB.
TTS_CACHE_MB=200
# edge (default, free). openai and azure are designed but not wired yet; leave as edge.
TTS_PROVIDER=edge
