# ---- ClaimDesk environment ----
# Copy to .env and fill in. Everything works without keys (manual entry mode); keys turn on live lookups.
PORT=4000
DATABASE_PATH=./data/claimdesk.sqlite
EVIDENCE_DIR=./data/evidence
DOCUMENTS_DIR=./data/documents
CHROMIUM_PATH=            # optional; auto-detected (PLAYWRIGHT_BROWSERS_PATH or system chromium)

# DVLA Vehicle Enquiry Service (free; register at developer-portal.driver-vehicle-licensing.api.gov.uk)
DVLA_VES_API_KEY=
# DVSA MOT History API (free; register at documentation.history.mot.api.gov.uk — OAuth2 client credentials + API key)
DVSA_MOT_CLIENT_ID=
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_API_KEY=
DVSA_MOT_SCOPE_URL=https://tapi.dvsa.gov.uk/.default
DVSA_MOT_TOKEN_URL=
# Companies House (free; developer.company-information.service.gov.uk)
COMPANIES_HOUSE_API_KEY=
# Optional commercial gateway for valuation / provenance (pay per lookup)
VEHICLE_GATEWAY_PROVIDER=
VEHICLE_GATEWAY_API_KEY=
# Optional LLM for drafting assistance (retrieval + citations; nothing is sent automatically)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Session / signing secrets
SESSION_SECRET=change-me
SIGNING_SECRET=change-me

# ---- Sign-in ----
# The owner account is created on first start. Change the password in Settings before real data goes in.
DEFAULT_LOGIN_USERNAME=courtesycars
DEFAULT_LOGIN_PASSWORD=CourtesyCars123!
LOGIN_PREFILL=true          # pre-fill the login form while the default password is unchanged
SESSION_TTL_HOURS=12
COOKIE_SECURE=              # default: true in production; the desktop app sets false (plain http on localhost)
TRUST_PROXY=loopback
ESIGN_DELIVERY=external     # 'handler' shows the signing code to the handler when no email/SMS sender exists
