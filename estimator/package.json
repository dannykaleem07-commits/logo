{
  "name": "engineer-report-studio",
  "productName": "Engineer Report Studio",
  "version": "1.0.0",
  "description": "AI-assisted vehicle engineering and accident damage assessment reports.",
  "main": "main.js",
  "private": true,
  "author": "Courtesy Cars Group UK Limited",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:oem": "node tools/build-oem.js",
    "test": "node tools/selftest.js && node tools/tests/core/checks.js && node tools/tests/core/fuzz.js && node tools/tests/report/checks.js && node tools/ai-mocktest.js && node tools/data-mocktest.js && node tools/build-oem.js --check && node tools/build-variants.js --check",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:dir": "electron-builder --dir",
    "build:variants": "node tools/build-variants.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "uk.co.courtesycars.engineer-report-studio",
    "productName": "Engineer Report Studio",
    "files": [
      "main.js",
      "preload.js",
      "ai.js",
      "vehicledata.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${name}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${name}-${version}-portable.${ext}",
      "unpackDirName": "engineer-report-studio"
    }
  }
}
